1 24 "app.manifest"
1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 1,1,4,0
PRODUCTVERSION 1,1,4,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "OBDcomm BLE for Windows"
            VALUE "FileVersion", "1.1.4.0"
            VALUE "ProductName", "OBDcomm"
            VALUE "ProductVersion", "1.1.4"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

#include <windows.h>

101 DIALOGEX 0, 0, 208, 78
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OBDcomm"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Enter password", 1002, 10, 10, 188, 10
    EDITTEXT 1001, 10, 24, 188, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Unlock", IDOK, 92, 53, 50, 15
    PUSHBUTTON "Exit", IDCANCEL, 148, 53, 50, 15
END
